# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real API keys or personal info.

GEMINI_API_KEY=your_gemini_api_key_here

# SEC EDGAR requires a real identifying User-Agent, or it will block
# requests. Format: "Your Name your_email@example.com"
SEC_USER_AGENT=Your Name your_email@example.com
